#%PAM-1.0
# PAM service for steam-session.service. systemd 257's pam_systemd gives user sessions an ambient
# CAP_WAKE_ALARM by default; any ambient capability makes pressure-vessel's bwrap refuse to start
# ("Unexpected capabilities but not setuid"), so no game launches. This session gets none.
account  include  common-account
session  required pam_loginuid.so
session  required pam_limits.so
session  required pam_unix.so
session  optional pam_systemd.so default-capability-ambient-set=
