[Unit]
Description=USB gadget: adb over the OTG port
DefaultDependencies=no
After=sys-kernel-config.mount local-fs.target
Before=sysinit.target

[Service]
ExecStart=/usr/local/sbin/usb-gadget start
ExecStopPost=/usr/local/sbin/usb-gadget stop
Restart=always
RestartSec=3

[Install]
WantedBy=sysinit.target
