[Unit]
Description=Steam Big Picture session (steam user, Xorg on tty7)
After=systemd-user-sessions.service network.target firstboot.service inputplumber.service
Wants=inputplumber.service
Conflicts=getty@tty7.service
StartLimitIntervalSec=0

[Service]
# A real logind session: user systemd instance (PipeWire), XDG_RUNTIME_DIR, rootless Xorg on seat0.
User=steam
PAMName=steam-session
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
Environment=XDG_SESSION_TYPE=x11 XDG_SESSION_CLASS=user XDG_SEAT=seat0 XDG_VTNR=7
ExecStartPre=+/usr/bin/chvt 7
ExecStartPre=+/usr/local/bin/steam-session-prep
# pam_systemd (systemd 257) gives user sessions an ambient CAP_WAKE_ALARM; any ambient capability makes
# pressure-vessel's bwrap refuse to run ("Unexpected capabilities but not setuid"), so games never start.
ExecStart=/usr/bin/setpriv --ambient-caps -all --inh-caps -all -- /usr/bin/startx /usr/local/bin/steam-session-x -- :0 vt7 -keeptty -nolisten tcp -s 0 -dpms
Restart=always
RestartSec=5
KillMode=control-group
# Steam takes minutes to wind down on this CPU; after 20 s the session is killed rather than stalling a restart.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
