[Unit]
Description=Steam Big Picture session (Xorg on the panel)
After=systemd-user-sessions.service network.target firstboot.service
Conflicts=getty@tty7.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/steam-session
Restart=always
RestartSec=5
TTYPath=/dev/tty7
StandardInput=null
StandardOutput=journal
StandardError=journal
KillMode=control-group

[Install]
WantedBy=multi-user.target
