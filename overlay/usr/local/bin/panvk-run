#!/bin/sh
# Runs a native Vulkan program on the Mali-G31 through PanVK (Mesa's Vulkan driver, Vulkan 1.0 on this GPU).
# PanVK is not enabled by default: Steam, Proton and DXVK would pick it first and fail on its missing
# features. Example: panvk-run vkcube
export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/panfrost_icd.json
exec "$@"
