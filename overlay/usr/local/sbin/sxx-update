#!/bin/bash
# In-place OS updates from GitHub releases. Steam's System > Software Updates calls steamos-update, which lands here.
#   sxx-update check        exit 0 and print the tag when a newer release exists, 7 when not
#   sxx-update apply        download and stage it; the initramfs writes it at the next boot (debug/initramfs/init)
#   sxx-update steamos ...  the argument conventions of Valve's steamos-update
# Staged on the data partition: root.img (the new root, 3 GiB) and boot/ (the new boot files). Nothing is written to the
# running system; the boot-time step overwrites the root partition and the boot files, and /home is never touched.
set -u
REPO=${SXX_UPDATE_REPO:-xXJSONDeruloXx/SteamOSXX}
API=${SXX_UPDATE_API:-https://api.github.com/repos/$REPO/releases/latest}
STATE=/home/.sxx/update
cur=$(cat /etc/sxx-release 2>/dev/null || echo dev)
say() { echo "sxx-update: $*" >&2; }

latest() {
  mkdir -p "$STATE"
  curl -fsS --max-time 30 -H 'Accept: application/vnd.github+json' "$API" -o "$STATE/latest.json" || return 1
  python3 - "$STATE/latest.json" <<'PY'
import json, sys
j = json.load(open(sys.argv[1]))
a = {x["name"]: x["browser_download_url"] for x in j.get("assets", [])}
print(j["tag_name"])
print(a.get("steamos-rg40xx.img.xz", ""))
print(a.get("steamos-rg40xx.img.xz.sha256", ""))
print("reflash" if "FULL-REFLASH-REQUIRED" in (j.get("body") or "") else "ok")
PY
}

newer() {
  [[ "$cur" =~ ^v[0-9]+\.[0-9]+ ]] || return 1
  [ "$cur" != "$1" ] && [ "$(printf '%s\n%s\n' "$cur" "$1" | sort -V | tail -1)" = "$1" ]
}

check() {
  local out tag
  out=$(latest) || { say "could not reach the release server"; return 7; }
  tag=$(sed -n 1p <<<"$out")
  newer "$tag" || return 7
  echo "$tag"
}

apply() {
  local out tag url shaurl flag want got
  out=$(latest) || { say "could not reach the release server"; return 1; }
  { read -r tag; read -r url; read -r shaurl; read -r flag; } <<<"$out"
  newer "$tag" || { say "already up to date ($cur)"; return 7; }
  [ "$flag" = ok ] || { say "$tag needs a full reflash; see its release notes"; return 1; }
  [ -n "$url" ] && [ -n "$shaurl" ] || { say "$tag has no image attached"; return 1; }
  if [ -f "$STATE/pending" ] && [ "$(cut -d' ' -f1 "$STATE/pending")" = "$tag" ]; then say "$tag is already staged; restart to install it"; return 0; fi
  [ "$(df -BM --output=avail /home | tail -1 | tr -dc 0-9)" -gt 5000 ] || { say "needs 5 GB free on the data partition"; return 1; }
  mkdir -p "$STATE"; rm -f "$STATE/pending" "$STATE/tries"
  want=$(curl -fsSL --max-time 30 "$shaurl" | awk '{print $1}')
  [ -n "$want" ] || { say "could not read the checksum"; return 1; }
  say "downloading $tag"
  curl -fL --retry 8 --retry-delay 3 --retry-all-errors -C - -o "$STATE/img.xz.part" "$url" || { say "download failed (run again to resume)"; return 1; }
  got=$(sha256sum "$STATE/img.xz.part" | awk '{print $1}')
  [ "$got" = "$want" ] || { say "checksum mismatch, discarding the download"; rm -f "$STATE/img.xz.part"; return 1; }
  say "unpacking"
  rm -rf "$STATE/root.img" "$STATE/boot" "$STATE/boot.img"
  # layout contract (tools/build-image.sh): 16 MiB of MBR and U-Boot, a 256 MiB boot partition, then the 3 GiB root
  xz -dc "$STATE/img.xz.part" | {
    dd of=/dev/null bs=1M count=16 iflag=fullblock status=none
    dd of="$STATE/boot.img" bs=1M count=256 iflag=fullblock status=none
    dd of="$STATE/root.img" bs=1M iflag=fullblock conv=sparse status=none
  }
  [ "$(stat -c %s "$STATE/root.img")" = 3221225472 ] || { say "unexpected image layout"; rm -f "$STATE/root.img" "$STATE/boot.img"; return 1; }
  mkdir -p "$STATE/boot" /run/sxx-update-boot
  mount -o loop,ro "$STATE/boot.img" /run/sxx-update-boot && cp -a /run/sxx-update-boot/. "$STATE/boot/"
  umount /run/sxx-update-boot; rmdir /run/sxx-update-boot
  [ -f "$STATE/boot/KERNEL" ] && [ -f "$STATE/boot/initrd.cpio.gz" ] || { say "boot files missing from the image"; return 1; }
  rm -f "$STATE/img.xz.part" "$STATE/boot.img"
  sync
  echo "$tag" > "$STATE/pending.tmp" && sync && mv "$STATE/pending.tmp" "$STATE/pending" && sync
  say "$tag staged; it installs at the next boot (about 3 minutes, do not power off)"
}

case "${1:-}" in
  check) check ;;
  apply) apply ;;
  status) echo "version: $cur"; [ -f "$STATE/pending" ] && echo "staged: $(cat "$STATE/pending")" ;;
  steamos)
    shift
    for a in "$@"; do [ "$a" = --supports-duplicate-detection ] && exit 0; done
    case "${1:-}" in
      check) check ;;
      *) apply ;;
    esac ;;
  *) echo "usage: sxx-update check|apply|status"; exit 2 ;;
esac
