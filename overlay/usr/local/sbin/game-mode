#!/bin/sh
# While a Steam game runs (a "reaper SteamLaunch" process exists), Steam's web helper runs at SCHED_IDLE:
# it still answers when the Steam menu is opened in game, but only gets CPU the game leaves free. Restored
# to normal scheduling when the game ends. On 4 A53 cores the web helper otherwise takes most of a core.
state=idle
while sleep 2; do
  if pgrep -u steam -f "reaper SteamLaunch" >/dev/null; then
    for p in $(pgrep -u steam -f steamwebhelper); do chrt -i -p 0 "$p" 2>/dev/null; done
    [ "$state" = idle ] && echo "game-mode: game running, web helper to SCHED_IDLE"
    state=game
  elif [ "$state" = game ]; then
    for p in $(pgrep -u steam -f steamwebhelper); do chrt -o -p 0 "$p" 2>/dev/null; done
    echo "game-mode: game ended, web helper back to normal"
    state=idle
  fi
done
