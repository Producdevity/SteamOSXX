#!/bin/sh
# Reboots (back to muOS in slot 1) when neither adb nor SSH has been serving for 5 minutes,
# so a running-but-unreachable system cannot strand the device while the watchdog keeps it alive.
bad=0
while sleep 30; do
  ok=
  pgrep -x adbd >/dev/null && [ -n "$(cat /sys/kernel/config/usb_gadget/g1/UDC 2>/dev/null)" ] && ok=adb
  [ -z "$ok" ] && ss -ltn 2>/dev/null | grep -q ':22 ' && ip -4 addr show wlan0 2>/dev/null | grep -q inet && ok=ssh
  if [ -n "$ok" ]; then bad=0; continue; fi
  bad=$((bad + 1))
  echo "reach-guard: no adb or ssh for $((bad * 30)) s"
  [ "$bad" -ge 10 ] && { echo "reach-guard: rebooting"; systemctl reboot --force; }
done
