#!/bin/sh
# One-time setup on the device: grow the root partition to the card, swapfile, new SSH host keys.
set -x
root=$(findmnt -no SOURCE /)
disk=/dev/$(lsblk -no PKNAME "$root")
part=$(cat /sys/class/block/${root##*/}/partition)
growpart "$disk" "$part" && resize2fs "$root"
[ -e /swapfile ] || { fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile; }
ssh-keygen -A
mkdir -p /var/log/journal && systemd-tmpfiles --create --prefix /var/log/journal
touch /var/lib/firstboot.done
