
# Boots whatever the power-on cause, so FEL and USB-powered starts are never cut off.
# CONFIG_AXP_DISABLE_BOOT_ON_POWERON is not set
# Expose the SD card to the host (ums) and accept flashing (fastboot).
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_VENDOR_NUM=0x1f3a
CONFIG_USB_GADGET_PRODUCT_NUM=0x1010
CONFIG_USB_FUNCTION_MASS_STORAGE=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_FASTBOOT_BUF_ADDR=0x45000000
CONFIG_FASTBOOT_BUF_SIZE=0x20000000
CONFIG_CMD_GPIO=y
CONFIG_CMD_MEMINFO=y

# FEL boot of the OS on the slot-2 card while muOS stays in slot 1. If it does not boot, reset:
# the boot ROM then boots muOS from slot 1, which can rewrite the slot-2 card directly.
CONFIG_MMC_SUNXI_SLOT_EXTRA=2
CONFIG_BOOTCOMMAND="gpio set PE4; mmc rescan; sysboot mmc 2:1 any ${scriptaddr} /extlinux/extlinux.conf; echo slot 2 did not boot, resetting to muOS; sleep 2; reset"
