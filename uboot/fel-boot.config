
# FEL boot of the OS on the slot-2 card while muOS stays in slot 1; if that fails,
# expose the slot-2 card over USB so the host can rewrite it.
CONFIG_MMC_SUNXI_SLOT_EXTRA=2
CONFIG_BOOTCOMMAND="gpio set PE4; mmc rescan; sysboot mmc 2:1 any ${scriptaddr} /extlinux/extlinux.conf; echo slot 2 did not boot, exposing it over USB; ums 0 mmc 2"
